class Solution {
public:
    int maximumJumps(vector<int>& nums, int target) {
        const int n = nums.size();
        assert(n >= 2 && n <= 1000);
        assert(target >= 0 && target <= 2000000000);
        for (int i = 0; i < n; ++i) {
            assert(abs(nums[i]) <= 1000000000);
        }
        vector<vector<int>> e;
        for (int i = 0; i < n; ++i) {
            for (int j = i + 1; j < n; ++j) {
                if (abs(nums[i] - nums[j]) <= target) {
                    e.push_back({i, j});
                }
            }
        }
        vector<int> d(n, -1);
        d[0] = 0;
        for (bool changed = true; changed;) {
            changed = false;
            for (const auto& v : e) {
                if (d[v[0]] >= 0 && d[v[1]] < d[v[0]] + 1) {
                    d[v[1]] = d[v[0]] + 1;
                    changed = true;
                }
            }
        }
        return d[n - 1];
    }
};
