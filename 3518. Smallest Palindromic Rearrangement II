from collections import Counter

class Solution:
    def smallestPalindrome(self, s: str, k: int) -> str:
        n = len(s)
        half_len = n // 2
        
        # Count character frequencies
        counts = Counter(s)
        half_counts = {ch: counts[ch] // 2 for ch in counts}
        
        # Identify middle character if string length is odd
        mid_char = ""
        for ch, cnt in counts.items():
            if cnt % 2 == 1:
                mid_char = ch
                break

        # Helper to compute nCr capped at cap
        def nCr(n_val, r_val, cap):
            if r_val < 0 or r_val > n_val:
                return 0
            if r_val == 0 or r_val == n_val:
                return 1
            if r_val > n_val // 2:
                r_val = n_val - r_val
            res = 1
            for i in range(1, r_val + 1):
                res = res * (n_val - i + 1) // i
                if res > cap:
                    return cap
            return res

        # Helper to compute total permutations of remaining character frequencies
        def count_permutations(freq_dict, cap):
            total_rem = sum(freq_dict.values())
            ans = 1
            for cnt in freq_dict.values():
                if cnt > 0:
                    ans *= nCr(total_rem, cnt, cap)
                    total_rem -= cnt
                    if ans > cap:
                        return cap
            return ans

        # Check if total possible palindromes is less than k
        total_possible = count_permutations(half_counts, k)
        if total_possible < k:
            return ""

        # Construct the left half character by character
        left_half = []
        
        for pos in range(half_len):
            for ch_code in range(26):
                ch = chr(ord('a') + ch_code)
                if half_counts.get(ch, 0) > 0:
                    # Try placing 'ch' at current position
                    half_counts[ch] -= 1
                    ways = count_permutations(half_counts, k)
                    
                    if ways >= k:
                        left_half.append(ch)
                        break  # Found correct character for this position
                    else:
                        k -= ways
                        half_counts[ch] += 1  # Backtrack and try next character

        left_str = "".join(left_half)
        return left_str + mid_char + left_str[::-1]
