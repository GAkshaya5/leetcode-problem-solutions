class Solution {
public:
    int maximumSaleItems(vector<vector<int>>& items, int budget) {
        int n = items.size();
        vector<int> freebies(n, 0);

        for (int i = 0; i < n; ++i) {
            int f_i = items[i][0];
            int cnt = 0;
            for (int j = 0; j < n; ++j) {
                if (i != j && items[j][0] % f_i == 0) {
                    ++cnt;
                }
            }
            freebies[i] = cnt;
        }

        vector<int> dp(budget + 1, 0);

        for (int i = 0; i < n; ++i) {
            int price = items[i][1];
            int bonus = freebies[i];

            for (int b = budget; b >= price; --b) {
                dp[b] = max(dp[b], dp[b - price] + 1 + bonus);
            }

            for (int b = price; b <= budget; ++b) {
                dp[b] = max(dp[b], dp[b - price] + 1);
            }
        }

        return dp[budget];
    }
};
