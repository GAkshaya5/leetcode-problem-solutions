class Solution:
    def predictTheWinner(self, nums: list[int]) -> bool:
        memo = {}

        def get_max_score(i: int, j: int) -> int:
            if i == j:
                return nums[i]
            if (i, j) in memo:
                return memo[(i, j)]

            # Player chooses left end or right end
            pick_left = nums[i] - get_max_score(i + 1, j)
            pick_right = nums[j] - get_max_score(i, j - 1)

            memo[(i, j)] = max(pick_left, pick_right)
            return memo[(i, j)]

        return get_max_score(0, len(nums) - 1) >= 0
