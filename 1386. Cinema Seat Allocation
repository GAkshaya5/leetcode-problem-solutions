#include <unordered_map>
#include <vector>

class Solution {
public:
    int maxNumberOfFamilies(int n, std::vector<std::vector<int>>& reservedSeats) {
        std::unordered_map<int, int> reservedMap;

        // Group reserved seats by row using bitmasks (bits 1 to 10 mapped to bit positions 0 to 9)
        for (const auto& seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];
            reservedMap[row] |= (1 << (col - 1));
        }

        // Start by assuming all n rows can take 2 families
        int maxFamilies = n * 2;

        for (const auto& [row, mask] : reservedMap) {
            bool leftPossible   = !(mask & (1 << 1 | 1 << 2 | 1 << 3 | 1 << 4)); // seats 2, 3, 4, 5
            bool rightPossible  = !(mask & (1 << 5 | 1 << 6 | 1 << 7 | 1 << 8)); // seats 6, 7, 8, 9
            bool middlePossible = !(mask & (1 << 3 | 1 << 4 | 1 << 5 | 1 << 6)); // seats 4, 5, 6, 7

            if (leftPossible && rightPossible) {
                // Both blocks fit, row capacity remains 2 (no reduction)
                continue;
            } else if (leftPossible || rightPossible || middlePossible) {
                // Only 1 group can fit in this row
                maxFamilies -= 1;
            } else {
                // 0 groups can fit in this row
                maxFamilies -= 2;
            }
        }

        return maxFamilies;
    }
};
