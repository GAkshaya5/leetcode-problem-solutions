class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        // Edge case: if k is 0 or 1, no product of positive integers can be strictly less than k
        if (k <= 1) return 0;
        
        int count = 0;
        int product = 1;
        int left = 0;
        
        for (int right = 0; right < nums.length; right++) {
            product *= nums[right];
            
            // Shrink the window from the left until the product is strictly less than k
            while (product >= k && left <= right) {
                product /= nums[left];
                left++;
            }
            
            // The number of valid subarrays ending at the current 'right' index 
            // is equal to the size of the window: (right - left + 1)
            count += (right - left + 1);
        }
        
        return count;
    }
}
