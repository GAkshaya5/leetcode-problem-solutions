class Solution {
public:
    int findMin(vector<int>& nums) {
        int left = 0;
        int right = nums.size() - 1;
        
        while (left < right) {
            int mid = left + (right - left) / 2;
            
            if (nums[mid] > nums[right]) {
                // Minimum is in the right unsorted part
                left = mid + 1;
            } else if (nums[mid] < nums[right]) {
                // Minimum is at mid or to the left of mid
                right = mid;
            } else {
                // When nums[mid] == nums[right], we can't decide the side.
                // Safely reduce the search space from the right.
                right--;
            }
        }
        
        return nums[left];
    }
};
