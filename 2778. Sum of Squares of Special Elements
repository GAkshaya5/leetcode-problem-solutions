class Solution:
    def sumOfSquares(self, nums: List[int]) -> int:
        n = len(nums)
        total_sum = 0
        
        # Iterate from index 1 to n (1-indexed)
        for i in range(1, n + 1):
            if n % i == 0:
                # In Python, 0-indexed array uses i - 1
                total_sum += nums[i - 1] ** 2
                
        return total_sum
