#include <stdlib.h>

// Comparison function to sort in descending order
int compare(const void *a, const void *b) {
    return (*(int*)b - *(int*)a);
}

int minimumCost(int* cost, int costSize) {
    // Sort the costs in descending order
    qsort(cost, costSize, sizeof(int), compare);
    
    int totalCost = 0;
    
    // Iterate through the sorted array
    for (int i = 0; i < costSize; i++) {
        // Skip every 3rd candy (indices 2, 5, 8, ...) because it's free!
        if ((i + 1) % 3 == 0) {
            continue;
        }
        totalCost += cost[i];
    }
    
    return totalCost;
}
