class Solution {
public:
    int jump(vector<int>& nums) {
        int jumps = 0;
        int current_end = 0;
        int farthest = 0;

        // We don't need to jump if we are already at the last element
        // So we loop until n - 1
        for (int i = 0; i < nums.size() - 1; ++i) {
            // Update the farthest point we can reach from the current index
            farthest = max(farthest, i + nums[i]);

            // If we've reached the end of the range for the current jump
            if (i == current_end) {
                jumps++;
                current_end = farthest;
                
                // If we can already reach the end, we can stop early
                if (current_end >= nums.size() - 1) break;
            }
        }

        return jumps;
    }
};
