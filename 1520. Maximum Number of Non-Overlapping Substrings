class Solution {
public:
    vector<string> maxNumOfSubstrings(string s) {
        int n = s.length();
        vector<int> first(26, -1), last(26, -1);
        
        // Step 1: Record first and last occurrence of each character
        for (int i = 0; i < n; ++i) {
            int ch = s[i] - 'a';
            if (first[ch] == -1) first[ch] = i;
            last[ch] = i;
        }

        vector<pair<int, int>> validIntervals; // stores {end, start}

        // Step 2: Expand intervals for each character's starting position
        for (int i = 0; i < 26; ++i) {
            if (first[i] == -1) continue;

            int start = first[i];
            int end = last[i];
            bool isValid = true;

            for (int j = start; j <= end; ++j) {
                int ch = s[j] - 'a';
                if (first[ch] < start) {
                    isValid = false; // Expands to the left before current start, invalid
                    break;
                }
                end = max(end, last[ch]);
            }

            if (isValid) {
                validIntervals.push_back({end, start});
            }
        }

        // Step 3: Sort by end index (Interval Scheduling)
        sort(validIntervals.begin(), validIntervals.end());

        vector<string> result;
        int lastEnd = -1;

        for (auto& [end, start] : validIntervals) {
            if (start > lastEnd) {
                result.push_back(s.substr(start, end - start + 1));
                lastEnd = end;
            }
        }

        return result;
    }
};
