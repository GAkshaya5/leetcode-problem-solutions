class Solution {
public:
    bool sumGame(string num) {
        int n = num.length();
        double sumDiff = 0;
        int qDiff = 0;

        for (int i = 0; i < n / 2; ++i) {
            if (num[i] == '?') qDiff++;
            else sumDiff += num[i] - '0';
        }

        for (int i = n / 2; i < n; ++i) {
            if (num[i] == '?') qDiff--;
            else sumDiff -= num[i] - '0';
        }

        // Bob wins if the remaining sum difference balances out 
        // with every pair of remaining '?' accounting for 9 points.
        return sumDiff + (qDiff / 2.0) * 9 != 0;
    }
};
