class Solution:
    def sortPermutation(self, nums: List[int]) -> int:
        ans = -1
        for i, val in enumerate(nums):
            # Check if the element is not in its correct position
            if val != i:
                if ans == -1:
                    ans = val
                else:
                    ans &= val
                    
        # If all elements are already in place, return 0
        return ans if ans != -1 else 0
