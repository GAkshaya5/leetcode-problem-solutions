class Solution {
    public int countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;
        // Frequency array to store counts of prefix balances.
        // Range of balance is from -n to n, so size 2 * n + 1 is enough.
        int[] freq = new int[2 * n + 1];
        
        // Initial state: prefix sum 0 has occurred once (before starting)
        int offset = n;
        freq[0 + offset] = 1;
        
        int currentBalance = 0;
        int result = 0;
        
        // countSmaller keeps track of how many prefix sums seen so far 
        // are strictly less than the currentBalance.
        int countSmaller = 0;
        
        for (int num : nums) {
            if (num == target) {
                // Moving from currentBalance to currentBalance + 1
                // All elements that were equal to currentBalance are now smaller than the new balance.
                countSmaller += freq[currentBalance + offset];
                currentBalance++;
            } else {
                // Moving from currentBalance to currentBalance - 1
                // Elements that were equal to the new balance (currentBalance - 1) are no longer smaller.
                currentBalance--;
                countSmaller -= freq[currentBalance + offset];
            }
            
            // Add all valid subarrays ending at this position
            result += countSmaller;
            
            // Record the current balance in our frequency tracker
            freq[currentBalance + offset]++;
        }
        
        return result;
    }
}
