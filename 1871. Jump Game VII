class Solution {
    public boolean canReach(String s, int minJump, int maxJump) {
        int n = s.length();
        // If the last character is '1', we can never reach it
        if (s.charAt(n - 1) == '1') {
            return false;
        }

        // dp[i] will be true if index i is reachable
        boolean[] dp = new boolean[n];
        dp[0] = true; // We start at index 0

        int reachableCount = 0;

        for (int i = 1; i < n; i++) {
            // Add the new element entering the window from the right side
            if (i >= minJump && dp[i - minJump]) {
                reachableCount++;
            }

            // Remove the old element leaving the window from the left side
            if (i > maxJump && dp[i - maxJump - 1]) {
                reachableCount--;
            }

            // If there is at least one reachable index in the window and current char is '0'
            if (reachableCount > 0 && s.charAt(i) == '0') {
                dp[i] = true;
            }
        }

        return dp[n - 1];
    }
}
