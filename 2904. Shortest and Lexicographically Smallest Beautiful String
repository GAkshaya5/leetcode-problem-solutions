#include <string>

class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int n = s.length();
        string ans = "";
        int onesCount = 0;
        int left = 0;

        for (int right = 0; right < n; ++right) {
            if (s[right] == '1') {
                onesCount++;
            }

            // Shrink window when we have exactly k ones
            while (onesCount == k) {
                // Trim leading zeros to make it as short as possible
                while (s[left] == '0') {
                    left++;
                }

                string currentStr = s.substr(left, right - left + 1);

                // Update answer if it's shorter or lexicographically smaller
                if (ans.empty() || currentStr.length() < ans.length() || 
                   (currentStr.length() == ans.length() && currentStr < ans)) {
                    ans = currentStr;
                }

                // Move left past the first '1' to continue searching
                if (s[left] == '1') {
                    onesCount--;
                }
                left++;
            }
        }

        return ans;
    }
};
