class Solution {
    private static final int MOD = 1_000_000_007;

    public int zigZagArrays(int n, int l, int r) {
        int m = r - l + 1;
        if (n == 1) return m;

        int size = 2 * m;
        long[][] T = new long[size][size];

        // Build the transition matrix
        // State 0 to m-1: UP states (expecting a larger number next)
        // State m to 2m-1: DOWN states (expecting a smaller number next)
        for (int x = 0; x < m; x++) {
            // From UP(x), we can go to DOWN(y) where y > x
            for (int y = x + 1; y < m; y++) {
                T[m + y][x] = 1;
            }
            // From DOWN(x), we can go to UP(y) where y < x
            for (int y = 0; y < x; y++) {
                T[y][m + x] = 1;
            }
        }

        // Exponentiate the matrix to the power of (n - 1)
        long[][] Tn = matrixPower(T, n - 1);

        // Initial state vector: for length 1, every element can be a start 
        // for both UP and DOWN direction paths.
        long totalWays = 0;
        for (int i = 0; i < size; i++) {
            long currentWays = 0;
            for (int j = 0; j < size; j++) {
                currentWays = (currentWays + Tn[i][j]) % MOD;
            }
            totalWays = (totalWays + currentWays) % MOD;
        }

        return (int) totalWays;
    }

    private long[][] matrixPower(long[][] base, int exp) {
        int size = base.length;
        long[][] result = new long[size][size];
        for (int i = 0; i < size; i++) {
            result[i][i] = 1;
        }

        while (exp > 0) {
            if ((exp & 1) == 1) {
                result = multiply(result, base);
            }
            base = multiply(base, base);
            exp >>= 1;
        }
        return result;
    }

    private long[][] multiply(long[][] A, long[][] B) {
        int size = A.length;
        long[][] C = new long[size][size];
        for (int i = 0; i < size; i++) {
            for (int k = 0; k < size; k++) {
                if (A[i][k] == 0) continue;
                for (int j = 0; j < size; j++) {
                    C[i][j] = (C[i][j] + A[i][k] * B[k][j]) % MOD;
                }
            }
        }
        return C;
    }
}
