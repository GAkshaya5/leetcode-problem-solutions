class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        // If the array has 2 or fewer elements, no duplicates need to be removed.
        if (nums.size() <= 2) {
            return nums.size();
        }
        
        // 'index' represents the position where the next valid element will be placed.
        int index = 2; 
        
        // Start scanning from the 3rd element (index 2)
        for (int i = 2; i < nums.size(); ++i) {
            // Compare the current element with the element 2 positions behind the write pointer
            if (nums[i] != nums[index - 2]) {
                nums[index] = nums[i];
                index++;
            }
        }
        
        // 'index' also represents the total count of valid elements remaining
        return index;
    }
};
