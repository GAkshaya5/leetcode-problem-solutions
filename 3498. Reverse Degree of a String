class Solution {
public:
    int reverseDegree(string s) {
        int total = 0;
        for (int i = 0; i < s.length(); ++i) {
            int rev_alpha_idx = 26 - (s[i] - 'a');
            int str_idx = i + 1;
            total += rev_alpha_idx * str_idx;
        }
        return total;
    }
};
