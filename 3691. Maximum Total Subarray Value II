#include <vector>
#include <queue>
#include <cmath>
#include <algorithm>

using namespace std;

class Solution {
private:
    int st_min[50005][17];
    int st_max[50005][17];
    int lg[50005];

    void buildSparseTable(const vector<int>& nums, int n) {
        lg[1] = 0;
        for (int i = 2; i <= n; i++) {
            lg[i] = lg[i / 2] + 1;
        }

        for (int i = 0; i < n; i++) {
            st_min[i][0] = nums[i];
            st_max[i][0] = nums[i];
        }

        for (int j = 1; (1 << j) <= n; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                st_min[i][j] = min(st_min[i][j - 1], st_min[i + (1 << (j - 1))][j - 1]);
                st_max[i][j] = max(st_max[i][j - 1], st_max[i + (1 << (j - 1))][j - 1]);
            }
        }
    }

    long long queryValue(int l, int r) {
        int k = lg[r - l + 1];
        int mn = min(st_min[l][k], st_min[r - (1 << k) + 1][k]);
        int mx = max(st_max[l][k], st_max[r - (1 << k) + 1][k]);
        return (long long)mx - mn;
    }

public:
    long long maxTotalValue(vector<int>& nums, int k) {
        int n = nums.size();
        buildSparseTable(nums, n);

        // Priority queue stores element as: {subarray_value, {l, r}}
        priority_queue<pair<long long, pair<int, int>>> pq;

        // Initialize heap with the largest ranges for each starting index 'l'
        for (int l = 0; l < n; l++) {
            long long val = queryValue(l, n - 1);
            pq.push({val, {l, n - 1}});
        }

        long long total_max_value = 0;

        // Extract the top k maximum values
        while (k-- > 0 && !pq.empty()) {
            auto top = pq.top();
            pq.pop();

            long long val = top.first;
            int l = top.second.first;
            int r = top.second.second;

            total_max_value += val;

            // If the range can be shrunk further from the right, push the next candidate
            if (r > l) {
                long long next_val = queryValue(l, r - 1);
                pq.push({next_val, {l, r - 1}});
            }
        }

        return total_max_value;
    }
};
