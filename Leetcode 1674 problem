class Solution:
    def minMoves(self, nums: List[int], limit: int) -> int:
        n = len(nums)
        half = n // 2
        # difference array index range: 0 .. 2*limit + 2 (we use up to high+1)
        diff = [0] * (2 * limit + 3)

        for i in range(half):
            a = nums[i]
            b = nums[n - 1 - i]
            if a > b:
                a, b = b, a

            total = a + b
            low = 1 + a             # smallest S achievable with 1 move
            high = limit + b        # largest S achievable with 1 move

            # default assume 2 moves for all sums: add 2 to full range [2, 2*limit]
            diff[2] += 2
            diff[2 * limit + 1] -= 2

            # sums in [low, high] require at most 1 move: subtract 1 from that range
            diff[low] -= 1
            diff[high + 1] += 1

            # exact sum total requires 0 moves: subtract 1 at total and add back 1 at total+1
            diff[total] -= 1
            diff[total + 1] += 1

        # prefix-sum to compute moves for each possible sum S
        best = float('inf')
        cur = 0
        for S in range(2, 2 * limit + 1):
            cur += diff[S]
            if cur < best:
                best = cur

        return best
