#include <vector>
#include <algorithm>

using namespace std;

class Solution {
    struct Interval {
        int l, r, weight, id;
    };

public:
    vector<int> maximumWeight(vector<vector<int>>& raw_intervals) {
        int n = raw_intervals.size();
        vector<Interval> intervals(n);
        
        for (int i = 0; i < n; ++i) {
            intervals[i] = {raw_intervals[i][0], raw_intervals[i][1], raw_intervals[i][2], i};
        }
        
        // Sort by start time `l`
        sort(intervals.begin(), intervals.end(), [](const Interval& a, const Interval& b) {
            if (a.l != b.l) return a.l < b.l;
            if (a.r != b.r) return a.r < b.r;
            return a.id < b.id;
        });

        // Binary search for next non-overlapping interval
        vector<int> next_pos(n);
        for (int i = 0; i < n; ++i) {
            int low = i + 1, high = n, ans = n;
            while (low < high) {
                int mid = low + (high - low) / 2;
                if (intervals[mid].l > intervals[i].r) {
                    ans = mid;
                    high = mid;
                } else {
                    low = mid + 1;
                }
            }
            next_pos[i] = ans;
        }

        vector<vector<long long>> dp_val(n + 1, vector<long long>(5, 0));
        vector<vector<vector<int>>> dp_path(n + 1, vector<vector<int>>(5));

        for (int i = n - 1; i >= 0; --i) {
            for (int k = 1; k <= 4; ++k) {
                // Option 1: Skip
                long long score_skip = dp_val[i + 1][k];
                const vector<int>& path_skip = dp_path[i + 1][k];

                // Option 2: Take
                int nxt = next_pos[i];
                long long score_take = intervals[i].weight + dp_val[nxt][k - 1];
                
                vector<int> path_take;
                path_take.reserve(k);
                path_take.push_back(intervals[i].id);
                path_take.insert(path_take.end(), dp_path[nxt][k - 1].begin(), dp_path[nxt][k - 1].end());
                
                // Keep path sorted to perform proper lexicographical comparison
                sort(path_take.begin(), path_take.end());

                if (score_take > score_skip) {
                    dp_val[i][k] = score_take;
                    dp_path[i][k] = move(path_take);
                } else if (score_skip > score_take) {
                    dp_val[i][k] = score_skip;
                    dp_path[i][k] = path_skip;
                } else {
                    // Tie-breaker: choose lexicographically smaller path
                    dp_val[i][k] = score_take;
                    if (path_skip.empty() || path_take < path_skip) {
                        dp_path[i][k] = move(path_take);
                    } else {
                        dp_path[i][k] = path_skip;
                    }
                }
            }
        }

        return dp_path[0][4];
    }
};
