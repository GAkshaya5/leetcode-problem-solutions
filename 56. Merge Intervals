class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {
        if (intervals.empty()) return {};

        // 1. Sort intervals based on the start time
        sort(intervals.begin(), intervals.end());

        vector<vector<int>> merged;
        // 2. Add the first interval to the result
        merged.push_back(intervals[0]);

        for (int i = 1; i < intervals.size(); i++) {
            // Get the last interval we added to our result
            vector<int>& lastMerged = merged.back();

            // 3. Check for overlap
            if (intervals[i][0] <= lastMerged[1]) {
                // There is an overlap, merge them by updating the end time
                lastMerged[1] = max(lastMerged[1], intervals[i][1]);
            } else {
                // No overlap, just add the current interval
                merged.push_back(intervals[i]);
            }
        }

        return merged;
    }
};
