class Solution {
public:
    int numTrees(int n) {
        // DP array to store the number of unique trees for 'i' nodes
        vector<int> dp(n + 1, 0);
        
        // Base cases
        dp[0] = 1; 
        dp[1] = 1;
        
        // Outer loop: Calculate unique trees sequentially from 2 nodes up to n nodes
        for (int i = 2; i <= n; ++i) {
            // Inner loop: Try every possible node 'j' as the root
            for (int j = 1; j <= i; ++j) {
                int left_nodes = j - 1;
                int right_nodes = i - j;
                
                dp[i] += dp[left_nodes] * dp[right_nodes];
            }
        }
        
        return dp[n];
    }
};
