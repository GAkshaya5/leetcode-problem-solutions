class Solution {
    public String multiply(String num1, String num2) {
        if (num1.equals("0") || num2.equals("0")) return "0";
        
        int n1 = num1.length(), n2 = num2.length();
        int[] res = new int[n1 + n2];
        
        // Iterate from right to left
        for (int i = n1 - 1; i >= 0; i--) {
            for (int j = n2 - 1; j >= 0; j--) {
                int product = (num1.charAt(i) - '0') * (num2.charAt(j) - '0');
                
                // sum of current product and previous carry/value at this position
                int sum = product + res[i + j + 1];
                
                // Update the current position and the carry position
                res[i + j + 1] = sum % 10;
                res[i + j] += sum / 10;
            }
        }
        
        // Build the string result
        StringBuilder sb = new StringBuilder();
        for (int val : res) {
            if (!(sb.length() == 0 && val == 0)) { // Skip leading zeros
                sb.append(val);
            }
        }
        
        return sb.toString();
    }
}
