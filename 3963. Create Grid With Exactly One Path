class Solution:
    def createGrid(self, m: int, n: int) -> list[str]:
        grid = [["."] * n for _ in range(m)]
        
        # Block every cell in the first column except the top-left corner (0, 0)
        for i in range(1, m):
            grid[i][0] = "#"
            
        # Block the entire last row except the bottom-left/first column cell (m - 1, 0)
        for j in range(1, n):
            grid[m - 1][j] = "#"
            
        return ["".join(row) for row in grid]
