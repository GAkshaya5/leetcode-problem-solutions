import java.util.*;

class Solution {
    public long countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;
        int[] pref = new int[n + 1];
        
        // Step 1 & 2: Transform and build prefix sums
        for (int i = 0; i < n; i++) {
            int val = (nums[i] == target) ? 1 : -1;
            pref[i + 1] = pref[i] + val;
        }
        
        // Step 4: Coordinate Compression for Fenwick Tree
        int[] sortedPref = pref.clone();
        Arrays.sort(sortedPref);
        
        // Remove duplicates to map ranks uniquely
        Map<Integer, Integer> ranks = new HashMap<>();
        int rank = 1;
        for (int val : sortedPref) {
            if (!ranks.containsKey(val)) {
                ranks.put(val, rank++);
            }
        }
        
        // Fenwick Tree (Binary Indexed Tree) Implementation
        int[] bit = new int[rank];
        long totalSubarrays = 0;
        
        for (int p : pref) {
            int r = ranks.get(p);
            // Query count of all previous prefixes with value < current value
            totalSubarrays += query(bit, r - 1);
            // Insert current prefix rank into Fenwick Tree
            update(bit, r, 1);
        }
        
        return totalSubarrays;
    }
    
    private void update(int[] bit, int idx, int val) {
        while (idx < bit.length) {
            bit[idx] += val;
            idx += idx & (-idx);
        }
    }
    
    private int query(int[] bit, int idx) {
        int sum = 0;
        while (idx > 0) {
            sum += bit[idx];
            idx -= idx & (-idx);
        }
        return sum;
    }
}
