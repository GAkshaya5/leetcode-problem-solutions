class Solution {
public:
    vector<int> findThePrefixCommonArray(vector<int>& A, vector<int>& B) {
        const int n = A.size();
        vector<int> r(n);
        unordered_set<int> a, b, c;
        for (int i = 0; i < n; ++i) {
            a.insert(A[i]);
            b.insert(B[i]);
            if (a.count(B[i])) {
                c.insert(B[i]);
            }
            if (b.count(A[i])) {
                c.insert(A[i]);
            }
            r[i] = c.size();
        }
        return r;
    }
};
