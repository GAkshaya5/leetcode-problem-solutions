#include <vector>
#include <unordered_map>
#include <cstdint>

using namespace std;

class Solution {
public:
    int smallestUniqueSubarray(vector<int>& nums) {
        int n = static_cast<int>(nums.size());
        const uint64_t MOD1 = 1000000007ULL;
        const uint64_t MOD2 = 1000000009ULL;
        const uint64_t BASE1 = 100003ULL;
        const uint64_t BASE2 = 100019ULL;

        vector<uint64_t> p1(n + 1, 1), p2(n + 1, 1);
        vector<uint64_t> h1(n + 1, 0), h2(n + 1, 0);

        for (int i = 0; i < n; ++i) {
            uint64_t val = static_cast<uint64_t>(nums[i]);
            p1[i + 1] = (p1[i] * BASE1) % MOD1;
            p2[i + 1] = (p2[i] * BASE2) % MOD2;
            h1[i + 1] = (h1[i] * BASE1 + val) % MOD1;
            h2[i + 1] = (h2[i] * BASE2 + val) % MOD2;
        }

        auto getHash = [&](int l, int r) -> uint64_t {
            uint64_t x1 = (h1[r + 1] + MOD1 - (h1[l] * p1[r - l + 1]) % MOD1) % MOD1;
            uint64_t x2 = (h2[r + 1] + MOD2 - (h2[l] * p2[r - l + 1]) % MOD2) % MOD2;
            return (x1 << 32) | x2;
        };

        auto hasUnique = [&](int len) -> bool {
            unordered_map<uint64_t, int> freq;
            freq.reserve(static_cast<size_t>(n - len + 1) * 2);
            for (int l = 0; l + len - 1 < n; ++l) {
                int r = l + len - 1;
                ++freq[getHash(l, r)];
            }
            for (const auto& kv : freq) {
                if (kv.second == 1) return true;
            }
            return false;
        };

        int low = 1, high = n, ans = n;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (hasUnique(mid)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return ans;
    }
};
