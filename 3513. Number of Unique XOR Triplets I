class Solution {
public:
    int uniqueXorTriplets(vector<int>& nums) {
        int n = nums.size();
        
        if (n == 1) return 1;
        if (n == 2) return 2;
        
        // Find the most significant bit (MSB) position
        int msb = 31 - __builtin_clz(n);
        
        // The total number of unique values is 2^(msb + 1)
        return 1 << (msb + 1);
    }
};
