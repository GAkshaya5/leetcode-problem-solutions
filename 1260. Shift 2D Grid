import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<List<Integer>> shiftGrid(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;
        int totalElements = m * n;
        
        // Effective shifts needed
        k = k % totalElements;
        
        // Initialize the result list structure
        List<List<Integer>> result = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            result.add(new ArrayList<>(n));
            for (int j = 0; j < n; j++) {
                result.get(i).add(0); // Fill with placeholder values
            }
        }
        
        // Map each element directly to its new position
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Convert 2D index (i, j) to 1D index
                int original1DIndex = i * n + j;
                
                // Calculate new 1D index after shifting k times
                int new1DIndex = (original1DIndex + k) % totalElements;
                
                // Convert new 1D index back to 2D index (newRow, newCol)
                int newRow = new1DIndex / n;
                int newCol = new1DIndex % n;
                
                // Place the element in its correct position
                result.get(newRow).set(newCol, grid[i][j]);
            }
        }
        
        return result;
    }
}
