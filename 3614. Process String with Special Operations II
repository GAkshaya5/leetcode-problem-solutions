#include <string>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    char processStr(string s, long long k) {
        int n = s.length();
        vector<long long> lengths(n);
        long long current_len = 0;

        // Step 1: Forward pass to track lengths
        for (int i = 0; i < n; ++i) {
            if (s[i] >= 'a' && s[i] <= 'z') {
                current_len++;
            } else if (s[i] == '*') {
                if (current_len > 0) current_len--;
            } else if (s[i] == '#') {
                current_len *= 2;
            } else if (s[i] == '%') {
                // Length doesn't change on reverse
            }
            lengths[i] = current_len;
        }

        // If k is completely out of bounds of the final string
        if (k < 0 || k >= current_len) {
            return '.';
        }

        // Step 2: Backward pass to decode the index k
        for (int i = n - 1; i >= 0; --i) {
            if (s[i] == '#') {
                long long half_len = lengths[i] / 2;
                if (k >= half_len) {
                    k %= half_len;
                }
            } else if (s[i] == '%') {
                k = lengths[i] - 1 - k;
            } else if (s[i] == '*') {
                // The character removed by '*' is skipped; we continue tracking k backwards
            } else {
                // It's a lowercase English letter
                if (k == lengths[i] - 1) {
                    return s[i];
                }
            }
        }

        return '.';
    }
};
