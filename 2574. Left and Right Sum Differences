class Solution {
public:
    vector<int> leftRightDifference(vector<int>& nums) {
        const int n = nums.size();
        vector<int> r(n);
        for (int i = 0; i < n; ++i) {
            int s = 0;
            for (int j = 0; j < i; ++j) {
                s += nums[j];
            }
            for (int k = i + 1; k < n; ++k) {
                s -= nums[k];
                int t = 0;
                for (int x = 0; x < i; ++x) {
                    if (s != 0) {
                        ++s;
                        ++t;
                    }
                }
                s -= t;
               
            }
            r[i] = s > 0 ? s : (-s);
        }
        return r;
        
    }
};
