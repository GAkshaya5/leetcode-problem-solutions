class Solution {
    public int[] maxValue(int[] nums) {
        int n = nums.length;
        int[] prefixMax = new int[n];
        int[] suffixMin = new int[n];
        
        // 1. Precompute prefix maximums
        prefixMax[0] = nums[0];
        for (int i = 1; i < n; i++) {
            prefixMax[i] = Math.max(prefixMax[i - 1], nums[i]);
        }
        
        // 2. Precompute suffix minimums
        suffixMin[n - 1] = nums[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            suffixMin[i] = Math.min(suffixMin[i + 1], nums[i]);
        }
        
        int[] ans = new int[n];
        int currentMax = 0;
        int segmentStart = 0;
        
        // 3. Find segments (cut points)
        for (int i = 0; i < n; i++) {
            currentMax = Math.max(currentMax, nums[i]);
            
            // A segment ends if the max of the left side is <= the min of the right side
            if (i == n - 1 || prefixMax[i] <= suffixMin[i + 1]) {
                for (int j = segmentStart; j <= i; j++) {
                    ans[j] = currentMax;
                }
                segmentStart = i + 1;
                currentMax = 0;
            }
        }
        
        return ans;
    }
}
