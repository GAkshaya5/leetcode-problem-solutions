class Solution {
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        // Edge case: if the grid is empty or the starting cell has an obstacle
        if (obstacleGrid == null || obstacleGrid.length == 0 || obstacleGrid[0][0] == 1) {
            return 0;
        }
        
        int m = obstacleGrid.length;
        int n = obstacleGrid[0].length;
        
        // 1D DP array to keep track of paths in the current row
        int[] dp = new int[n];
        dp[0] = 1; // Base case: 1 way to start at the top-left corner
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (obstacleGrid[i][j] == 1) {
                    // Obstacle found: no paths can pass through this cell
                    dp[j] = 0;
                } else if (j > 0) {
                    // Update current cell path count by adding paths from the left
                    dp[j] += dp[j - 1];
                }
            }
        }
        
        return dp[n - 1];
    }
}
