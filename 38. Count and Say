class Solution:
    def countAndSay(self, n: int) -> str:
        # Base case
        result = "1"
        
        # We already have n=1, so we iterate n-1 times
        for _ in range(n - 1):
            next_str = []
            i = 0
            while i < len(result):
                count = 1
                # Count consecutive identical characters
                while i + 1 < len(result) and result[i] == result[i+1]:
                    count += 1
                    i += 1
                
                # Append count followed by the digit
                next_str.append(str(count))
                next_str.append(result[i])
                i += 1
            
            result = "".join(next_str)
            
        return result
