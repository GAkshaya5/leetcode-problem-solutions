#include <vector>
#include <algorithm>

class Solution {
public:
    int minSumOfLengths(std::vector<int>& arr, int target) {
        int n = arr.size();
        std::vector<int> min_len(n, INT_MAX);
        
        int left = 0;
        int current_sum = 0;
        int min_combined_length = INT_MAX;
        int min_so_far = INT_MAX;
        
        for (int right = 0; right < n; ++right) {
            current_sum += arr[right];
            
            // Shrink window if sum exceeds target
            while (current_sum > target && left <= right) {
                current_sum -= arr[left];
                left++;
            }
            
            // Found a valid subarray with sum == target
            if (current_sum == target) {
                int current_length = right - left + 1;
                
                // If there exists a valid subarray before current subarray start (`left - 1`)
                if (left > 0 && min_len[left - 1] != INT_MAX) {
                    min_combined_length = std::min(min_combined_length, current_length + min_len[left - 1]);
                }
                
                min_so_far = std::min(min_so_far, current_length);
            }
            
            // Record best subarray length ending at or before `right`
            min_len[right] = min_so_far;
        }
        
        return min_combined_length == INT_MAX ? -1 : min_combined_length;
    }
};
