class Solution {
    public int findUnsortedSubarray(int[] nums) {
        int n = nums.length;
        int end = -1;
        int start = 0;
        
        int max = nums[0];
        int min = nums[n - 1];
        
        // 1. Traverse from left to right to find the right boundary (end)
        for (int i = 1; i < n; i++) {
            if (nums[i] < max) {
                end = i; // 'i' should be >= max, so it's out of order
            } else {
                max = nums[i];
            }
        }
        
        // 2. Traverse from right to left to find the left boundary (start)
        for (int i = n - 2; i >= 0; i--) {
            if (nums[i] > min) {
                start = i; // 'i' should be <= min, so it's out of order
            } else {
                min = nums[i];
            }
        }
        
        // If end is still -1, the array is already sorted
        return end == -1 ? 0 : end - start + 1;
    }
}
