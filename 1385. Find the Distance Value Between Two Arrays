#include <vector>
#include <algorithm>
#include <cmath>

class Solution {
public:
    int findTheDistanceValue(std::vector<int>& arr1, std::vector<int>& arr2, int d) {
        // Sort arr2 to enable binary search
        std::sort(arr2.begin(), arr2.end());
        int distanceValue = 0;

        for (int x : arr1) {
            // Find the first element in arr2 that is >= x
            auto it = std::lower_bound(arr2.begin(), arr2.end(), x);
            bool isValid = true;

            // Check the element >= x
            if (it != arr2.end()) {
                if (std::abs(*it - x) <= d) {
                    isValid = false;
                }
            }

            // Check the element < x (preceding element)
            if (isValid && it != arr2.begin()) {
                auto prevIt = std::prev(it);
                if (std::abs(*prevIt - x) <= d) {
                    isValid = false;
                }
            }

            if (isValid) {
                distanceValue++;
            }
        }

        return distanceValue;
    }
};
