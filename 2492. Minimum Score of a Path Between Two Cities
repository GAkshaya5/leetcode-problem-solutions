#include <vector>
#include <queue>
#include <climits>
#include <algorithm>

using namespace std;

class Solution {
public:
    int minScore(int n, vector<vector<int>>& roads) {
        // Step 1: Build the adjacency list
        // graph[u] = pair<neighbor, distance>
        vector<vector<pair<int, int>>> graph(n + 1);
        for (const auto& road : roads) {
            int u = road[0];
            int v = road[1];
            int dist = road[2];
            graph[u].push_back({v, dist});
            graph[v].push_back({u, dist});
        }

        // Step 2: BFS traversal from city 1
        queue<int> q;
        vector<bool> visited(n + 1, false);
        
        q.push(1);
        visited[1] = true;
        int min_score = INT_MAX;

        while (!q.empty()) {
            int node = q.front();
            q.pop();

            for (const auto& edge : graph[node]) {
                int neighbor = edge.first;
                int dist = edge.second;

                // Track the absolute minimum edge weight seen in this component
                min_score = min(min_score, dist);

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push(neighbor);
                }
            }
        }

        return min_score;
    }
};
