class Solution {
public:
    int distinctSubseqII(string s) {
        long long endsWith[26] = {0};
        int mod = 1e9 + 7;
        
        for (char c : s) {
            long long totalBefore = 0;
            for (int i = 0; i < 26; ++i) {
                totalBefore = (totalBefore + endsWith[i]) % mod;
            }
            // 1 accounts for the single-character subsequence formed by 'c' itself
            endsWith[c - 'a'] = (totalBefore + 1) % mod;
        }
        
        long long result = 0;
        for (int i = 0; i < 26; ++i) {
            result = (result + endsWith[i]) % mod;
        }
        
        return result;
    }
};
