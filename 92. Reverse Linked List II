class Solution {
public:
    ListNode* reverseBetween(ListNode* head, int left, int right) {
        if (!head || left == right) return head;
        
        // Dummy node to handle edge case where left = 1
        ListNode* dummy = new ListNode(0);
        dummy->next = head;
        ListNode* prev = dummy;
        
        // Step 1: Move prev to the node right before the 'left' position
        for (int i = 0; i < left - 1; ++i) {
            prev = prev->next;
        }
        
        // Step 2: Initialize curr as the first node to be reversed
        ListNode* curr = prev->next;
        
        // Step 3: Reverse the sublist iteratively
        for (int i = 0; i < right - left; ++i) {
            ListNode* then = curr->next;
            curr->next = then->next;
            then->next = prev->next;
            prev->next = then;
        }
        
        ListNode* newHead = dummy->next;
        delete dummy; // Clean up memory
        return newHead;
    }
};
