class Solution {
    
    multiset<int> s1, s2;
    long long sum1, sum2;
    
    void better(long long &x, long long y) {
        if (x < 0 || x > y) {
            x = y;
        }
    }
    

    void adjust() {
        while (s1.size() > s2.size() + 1) {
            s2.insert(-*s1.begin());
            sum1 -= -*s1.begin();
            sum2 += -*s1.begin();
            s1.erase(s1.begin());
        }
        while (s2.size() > s1.size() + 1) {
            s1.insert(-*s2.begin());
            sum1 += *s2.begin();
            sum2 -= *s2.begin();
            s2.erase(s2.begin());
        }
    }

    void addNum(int num) {
        if (s1.empty()) {
            s2.insert(num);
            sum2 += num;
        } else if (s2.empty()) {
            s1.insert(-num);
            sum1 += num;
        } else if (num >= *s2.begin()) {
            s2.insert(num);
            sum2 += num;
        } else {
            s1.insert(-num);
            sum1 += num;
        }
        adjust();
    }
    
    void delNum(int num) {
        auto t = s2.find(num);
        if (t != s2.end()) {
            sum2 -= num;
            s2.erase(t);
        } else {
            t = s1.find(-num);
            if (t != s1.end()) {
                sum1 -= num;
                s1.erase(t);
            }
        }
        adjust();

    }
    
    long long go() {
        const long long m = s1.size() > s2.size() ? (-*s1.begin()) : *s2.begin();
        return m * s1.size() - sum1 + sum2 - m * s2.size();                    
    }
public:
    long long minOperations(vector<int>& nums, int x, int k) {
        sum1 = sum2 = 0;
        s1.clear();
        s2.clear();
        const int n = nums.size();
        vector<vector<long long>> dp(n + 1, vector<long long>(k + 1, -1));
        dp[0][0] = 0;
        for (int i = 1; i <= n; ++i) {
            dp[i] = dp[i - 1];
            addNum(nums[i - 1]);
            if (i > x) {
                delNum(nums[i - x - 1]);
            }
            if (i >= x) {
                const long long d = go();
                for (int j = 0; j < k; ++j) {
                    if (dp[i - x][j] >= 0) {
                        better(dp[i][j + 1], dp[i - x][j] + d);
                    }
                }
                
            }
        }
        return dp[n][k];
        
    }
};
