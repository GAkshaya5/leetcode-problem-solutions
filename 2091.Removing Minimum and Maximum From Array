class Solution:
    def minimumDeletions(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 2:
            return n
        
        # Step 1: Find the indices of the minimum and maximum elements
        min_idx = nums.index(min(nums))
        max_idx = nums.index(max(nums))
        
        # Step 2: Ensure i is always the smaller index and j is the larger index
        i, j = min(min_idx, max_idx), max(max_idx, min_idx)
        
        # Step 3: Calculate the cost for each of the 3 strategies
        del_front = j + 1
        del_back = n - i
        del_both = (i + 1) + (n - j)
        
        # Step 4: Return the minimum of the three strategies
        return min(del_front, del_back, del_both)
