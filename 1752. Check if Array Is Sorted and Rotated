class Solution {
    public boolean check(int[] nums) {
        int count = 0;
        int n = nums.length;
        
        for (int i = 0; i < n; i++) {
            // Compare current element with the next element (wraps around to 0 at the end)
            if (nums[i] > nums[(i + 1) % n]) {
                count++;
            }
            
            // If we find more than one drop, it cannot be a rotated sorted array
            if (count > 1) {
                return false;
            }
        }
        
        return true;
    }
}
