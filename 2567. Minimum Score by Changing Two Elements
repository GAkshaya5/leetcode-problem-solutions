class Solution {
public:
    int minimizeSum(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int n = nums.size();
        int removeTwoLargest = nums[n - 3] - nums[0];
        int removeTwoSmallest = nums[n - 1] - nums[2];
        int removeBothEnds = nums[n - 2] - nums[1];
        return min({removeTwoLargest, removeTwoSmallest, removeBothEnds});
    }
};
