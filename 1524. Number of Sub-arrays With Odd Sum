class Solution {
public:
    int numOfSubarrays(vector<int>& arr) {
        long long oddCount = 0, evenCount = 1; // evenCount = 1 accounts for prefix sum 0
        long long currentSum = 0;
        long long totalOddSubarrays = 0;
        int MOD = 1e9 + 7;

        for (int num : arr) {
            currentSum += num;
            
            if (currentSum % 2 != 0) {
                totalOddSubarrays = (totalOddSubarrays + evenCount) % MOD;
                oddCount++;
            } else {
                totalOddSubarrays = (totalOddSubarrays + oddCount) % MOD;
                evenCount++;
            }
        }

        return totalOddSubarrays;
    }
};
