class Solution {
private:
    void backtrack(vector<string>& result, string current, int open, int close, int maxCount) {
        // Base case: string length reaches 2 * n
        if (current.length() == maxCount * 2) {
            result.push_back(current);
            return;
        }

        // Add an open parenthesis if we haven't used all `n` open brackets
        if (open < maxCount) {
            backtrack(result, current + "(", open + 1, close, maxCount);
        }

        // Add a close parenthesis if it won't exceed the number of open brackets
        if (close < open) {
            backtrack(result, current + ")", open, close + 1, maxCount);
        }
    }

public:
    vector<string> generateParenthesis(int n) {
        vector<string> result;
        backtrack(result, "", 0, 0, n);
        return result;
    }
};
