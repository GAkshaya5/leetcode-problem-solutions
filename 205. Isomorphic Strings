class Solution {
    public boolean isIsomorphic(String s, String t) {
        // Since ASCII characters are expected, an array size of 256 is sufficient.
        int[] mapS = new int[256];
        int[] mapT = new int[256];
        
        for (int i = 0; i < s.length(); i++) {
            char charS = s.charAt(i);
            char charT = t.charAt(i);
            
            // If the last seen positions do not match, they are not isomorphic
            if (mapS[charS] != mapT[charT]) {
                return false;
            }
            
            // Store the current index + 1 (to avoid the default 0 value conflict)
            mapS[charS] = i + 1;
            mapT[charT] = i + 1;
        }
        
        return true;
    }
}
