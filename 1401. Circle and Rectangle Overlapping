class Solution {
public:
    bool checkOverlap(int radius, int xCenter, int yCenter, int x1, int y1, int x2, int y2) {
        // Find the closest point inside the rectangle to the circle's center
        int nearestX = std::max(x1, std::min(xCenter, x2));
        int nearestY = std::max(y1, std::min(yCenter, y2));
        
        int dx = nearestX - xCenter;
        int dy = nearestY - yCenter;
        
        // Check if squared distance is within radius squared
        return (dx * dx + dy * dy) <= (radius * radius);
    }
};
