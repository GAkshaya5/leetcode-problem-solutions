class Solution {
public:
    int stoneGameVIII(vector<int>& stones) {
        int n = stones.size();
        
        // Compute prefix sums in-place
        vector<long long> pref(n);
        pref[0] = stones[0];
        for (int i = 1; i < n; ++i) {
            pref[i] = pref[i - 1] + stones[i];
        }

        // Base case: If we pick all stones up to index n-1
        long long maxDiff = pref[n - 1];

        // Process backward from n-2 down to 1
        for (int i = n - 2; i >= 1; --i) {
            maxDiff = max(maxDiff, pref[i] - maxDiff);
        }

        return maxDiff;
    }
};
