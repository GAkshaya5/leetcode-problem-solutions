#include <stdlib.h>
#include <string.h>

#include <stdio.h>

#define MOD 1000000007
#define LOGN 18  // Since 2^17 = 131072 > 10^5

// Graph Structure (Adjacency List using compressed arrays)
typedef struct {
    int *head;
    int *to;
    int *next;
    int edge_cnt;
} Graph;

void add_edge(Graph *g, int u, int v) {
    g->to[g->edge_cnt] = v;
    g->next[g->edge_cnt] = g->head[u];
    g->head[u] = g->edge_cnt++;
}

// Fast Modular Exponentiation: (base^exp) % MOD
long long power(long long base, long long exp) {
    long long res = 1;
    base %= MOD;
    while (exp > 0) {
        if (exp % 2 == 1) res = (res * base) % MOD;
        base = (base * base) % MOD;
        exp /= 2;
    }
    return res;
}

// LCA & Binary Lifting structures
int up[100005][LOGN];
int depth[100005];

// Iterative BFS to avoid stack overflow on deep trees
void bfs(int root, int n, Graph *g) {
    int *queue = (int *)malloc(sizeof(int) * (n + 1));
    int front = 0, rear = 0;

    memset(depth, -1, sizeof(int) * (n + 1));
    memset(up, 0, sizeof(up));

    queue[rear++] = root;
    depth[root] = 0;
    up[root][0] = root;

    while (front < rear) {
        int u = queue[front++];
        
        for (int i = g->head[u]; i != -1; i = g->next[i]) {
            int v = g->to[i];
            if (depth[v] == -1) {
                depth[v] = depth[u] + 1;
                up[v][0] = u;
                for (int j = 1; j < LOGN; j++) {
                    up[v][j] = up[up[v][j - 1]][j - 1];
                }
                queue[rear++] = v;
            }
        }
    }
    free(queue);
}

// Find LCA using Binary Lifting
int get_lca(int u, int v) {
    if (depth[u] < depth[v]) {
        int temp = u; u = v; v = temp;
    }
    
    // Bring both nodes to the same depth
    for (int j = LOGN - 1; j >= 0; j--) {
        if (depth[u] - (1 << j) >= depth[v]) {
            u = up[u][j];
        }
    }
    
    if (u == v) return u;

    // Lift both nodes simultaneously right under their common ancestor
    for (int j = LOGN - 1; j >= 0; j--) {
        if (up[u][j] != up[v][j]) {
            u = up[u][j];
            v = up[v][j];
        }
    }
    return up[u][0];
}

int* assignEdgeWeights(int** edges, int edgesSize, int* edgesColSize, int** queries, int queriesSize, int* queriesColSize, int* returnSize) {
    int n = edgesSize + 1;
    
    // Initialize Graph Adjacency List
    Graph g;
    g.head = (int *)malloc(sizeof(int) * (n + 1));
    g.to = (int *)malloc(sizeof(int) * (2 * edgesSize));
    g.next = (int *)malloc(sizeof(int) * (2 * edgesSize));
    g.edge_cnt = 0;
    memset(g.head, -1, sizeof(int) * (n + 1));

    for (int i = 0; i < edgesSize; i++) {
        int u = edges[i][0];
        int v = edges[i][1];
        add_edge(&g, u, v);
        add_edge(&g, v, u);
    }

    // Precompute depths and binary lifting jump table
    bfs(1, n, &g);

    int *answer = (int *)malloc(sizeof(int) * queriesSize);
    *returnSize = queriesSize;

    for (int i = 0; i < queriesSize; i++) {
        int u = queries[i][0];
        int v = queries[i][1];

        if (u == v) {
            answer[i] = 0;
        } else {
            int lca = get_lca(u, v);
            int dist = depth[u] + depth[v] - 2 * depth[lca];
            answer[i] = (int)power(2, dist - 1);
        }
    }

    // Clean up dynamically allocated memory
    free(g.head);
    free(g.to);
    free(g.next);

    return answer;
}
