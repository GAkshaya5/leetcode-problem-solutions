#include <vector>
#include <queue>
#include <algorithm>

using namespace std;

class Solution {
public:
    int findMaxPathScore(vector<vector<int>>& edges, vector<bool>& online, long long k) {
        // FIXED: Changed online.length() to online.size()
        int n = online.size(); 
        
        // Step 1: Filter edges and find search boundaries
        int max_cost = -1;
        vector<vector<vector<int>>> adj(n);
        vector<int> in_degree_orig(n, 0);
        
        for (const auto& edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int cost = edge[2];
            
            // If the source or destination node of the edge is offline, skip it.
            if (!online[u] || !online[v]) continue;
            
            adj[u].push_back({v, cost});
            in_degree_orig[v]++;
            max_cost = max(max_cost, cost);
        }
        
        // Kahn's algorithm to get topological sort of the valid online subgraph
        vector<int> topo;
        queue<int> q;
        for (int i = 0; i < n; ++i) {
            if (online[i] && in_degree_orig[i] == 0) {
                q.push(i);
            }
        }
        
        while (!q.empty()) {
            int u = q.front();
            q.pop();
            topo.push_back(u);
            for (const auto& edge : adj[u]) {
                int v = edge[0];
                if (--in_degree_orig[v] == 0) {
                    q.push(v);
                }
            }
        }
        
        // Lambda function to check if a path exists where every edge >= mid and total cost <= k
        auto check = [&](int mid) -> bool {
            // dp[i] stores the minimum total cost to reach node i from node 0
            vector<long long> dp(n, -1);
            dp[0] = 0;
            
            for (int u : topo) {
                if (dp[u] == -1) continue;
                
                for (const auto& edge : adj[u]) {
                    int v = edge[0];
                    int cost = edge[1];
                    
                    // We can only use edges with a cost of at least `mid`
                    if (cost >= mid) {
                        if (dp[v] == -1 || dp[u] + cost < dp[v]) {
                            dp[v] = dp[u] + cost;
                        }
                    }
                }
            }
            
            return dp[n - 1] != -1 && dp[n - 1] <= k;
        };
        
        // Step 2: Binary search on the answer
        int low = 0, high = max_cost, ans = -1;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (check(mid)) {
                ans = mid;       // Found a valid configuration, try for a larger minimum edge cost
                low = mid + 1;
            } else {
                high = mid - 1;  // Too restrictive, lower the minimum edge cost requirement
            }
        }
        
        return ans;
    }
};
